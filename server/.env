# Server Configuration 
PORT = 5000
NODE_ENV = development

# Database Configuration 
# Will set these up when configuring MySQL 
DB_HOST = localhost
DB_PORT = 3306
DB_NAME = tasklify_db
DB_USER = root
DB_PASSWORD = my_sql_password 

# JWT Configuration - secret key used to sign JWT tokens, in production this should be a long, random string
JWT_SECRET = super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN = 7d

# CORS Configuration 
CLIENT_URL = http://localhost:3000